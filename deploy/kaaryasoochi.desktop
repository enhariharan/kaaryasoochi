[Desktop Entry]
Version=1.0
Type=Application
Name=Kaaryasoochi
GenericName=Job Scheduler
Comment=Schedule and manage cron-style jobs
Exec=INSTALL_DIR/linux/kaaryasoochi-app
Icon=kaaryasoochi
Terminal=false
StartupWMClass=kaaryasoochi
Categories=Utility;
Keywords=cron;job;scheduler;task;automation;
