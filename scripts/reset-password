#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Hariharan Narayanan

# Resets a Kaaryasoochi account's password from the command line.
#
#   scripts/reset-password              list the accounts (and whether each has a secret question)
#   scripts/reset-password USERNAME     set a new password for USERNAME
#
# No old password or secret answer is needed: whoever can run this on the server already controls
# the database. The new password is typed here, twice and without echo (never as an argument),
# and every session for that account is signed out. Works while the service is running.
#
# Database: $KAARYASOOCHI_DATABASE_URL, else ~/.local/share/kaaryasoochi/kaaryasoochi.db
# (never created if missing). The first run builds the small admin tool (a minute or two).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/target/release/kaaryasoochi-admin"

case "${1:-}" in
  -h|--help) sed -n '5,17p' "$0"; exit 0 ;;
esac

if [[ ! -x "$BIN" || -n "$(find "$ROOT/crates/admin" "$ROOT/crates/db/src" "$ROOT/crates/core/src" -newer "$BIN" -name '*.rs' -print -quit 2>/dev/null)" ]]; then
  echo "Building the admin tool..." >&2
  (cd "$ROOT" && cargo build --release -p kaaryasoochi-admin >&2)
fi

if [[ $# -eq 0 ]]; then
  exec "$BIN" list
fi
[[ $# -eq 1 ]] || { echo "usage: scripts/reset-password [USERNAME]" >&2; exit 2; }
exec "$BIN" reset-password "$1"
