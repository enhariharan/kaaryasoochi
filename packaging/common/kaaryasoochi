# Opens Kaaryasoochi. Jobs are run by a separate per-user server, the systemd *user* service
# kaaryasoochi-server.service (never root). Before opening the UI this launcher:
#   1. writes that unit to ~/.config/systemd/user when no package ships it (the snap sets
#      KAARYASOOCHI_SERVER_EXEC), and removes such a copy once a package provides the unit;
#   2. enables it on the first launch only, so the scheduler keeps running after the window closes
#      and starts at every login; a later `systemctl --user disable` is respected;
#   3. starts it, or restarts it if it is still running a binary an upgrade has replaced;
#   4. opens the desktop window, or the web UI in the default browser if no window is installed.
# Without a systemd user manager it starts the server in the background instead.
#
# PORT (default 8080) must match the server URL the desktop window was built for.
set -eu

self=$(readlink -f "$0")
bindir=$(dirname "$self")
prefix=$(dirname "$bindir")
lib="$prefix/lib/kaaryasoochi"
unit=kaaryasoochi-server.service
port=${PORT:-8080}
state=${XDG_STATE_HOME:-$HOME/.local/state}/kaaryasoochi
user_unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit
marker="# Written by the kaaryasoochi launcher; rewritten whenever it differs."

warn() { echo "kaaryasoochi: $*" >&2; }

listening() { ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; }

wait_listening() {
  command -v ss >/dev/null 2>&1 || { sleep 1; return 0; }
  i=0
  while [ "$i" -lt 40 ]; do
    listening && return 0
    sleep 0.25
    i=$((i + 1))
  done
  warn "the server is not listening on 127.0.0.1:$port yet (journalctl --user -u $unit)"
}

have_user_systemd() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

ours() { [ -f "$user_unit" ] && grep -qxF "$marker" "$user_unit"; }

# The packaged unit with this install's ExecStart, plus a condition so a unit left behind by a
# removed snap is skipped instead of failing at every login.
render_unit() {
  exec_cmd=$KAARYASOOCHI_SERVER_EXEC
  sed -e "s|^ExecStart=.*|ExecStart=$exec_cmd|" \
      -e "s|^\[Unit\]\$|[Unit]\nConditionPathExists=${exec_cmd%% *}|" \
      -e "3a\\
$marker" \
      "$prefix/lib/systemd/user/$unit"
}

sync_unit() {
  changed=0
  if [ -n "${KAARYASOOCHI_SERVER_EXEC:-}" ]; then
    if [ -f "$user_unit" ] && ! ours; then
      warn "keeping $user_unit: it was not written by this launcher"
      return 0
    fi
    want=$(render_unit)
    if ! ours || [ "$(cat "$user_unit")" != "$want" ]; then
      mkdir -p "$(dirname "$user_unit")"
      printf '%s\n' "$want" >"$user_unit"
      changed=1
    fi
  elif ours; then
    rm -f "$user_unit"
    changed=1
  fi
  [ "$changed" -eq 0 ] || systemctl --user daemon-reload
}

# True when the running server's binary was replaced by a package upgrade (deleted file) or
# belongs to an older snap revision than this launcher.
server_outdated() {
  pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null || echo 0)
  [ "${pid:-0}" -gt 0 ] || return 1
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
  case "$exe" in
    *" (deleted)") return 0 ;;
    /snap/*) case "$exe" in "$prefix"/*) return 1 ;; *) return 0 ;; esac ;;
  esac
  return 1
}

start_with_systemd() {
  sync_unit
  if ! systemctl --user cat "$unit" >/dev/null 2>&1; then
    warn "no $unit is installed"
    return 1
  fi
  if [ ! -e "$state/enabled-once" ]; then
    systemctl --user enable "$unit" >/dev/null 2>&1 || warn "could not enable $unit"
    mkdir -p "$state"
    : >"$state/enabled-once"
    [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" = yes ] ||
      warn "jobs run while you are logged in; to run them at boot too: sudo loginctl enable-linger $(id -un)"
  fi
  if systemctl --user is-active --quiet "$unit"; then
    if server_outdated; then
      systemctl --user restart "$unit"
    else
      return 0
    fi
  else
    systemctl --user start "$unit" || warn "could not start $unit (journalctl --user -u $unit)"
  fi
  wait_listening
}

start_detached() {
  listening && return 0
  log=${XDG_STATE_HOME:-$HOME/.local/state}/kaaryasoochi/server.log
  mkdir -p "$(dirname "$log")"
  setsid "$bindir/kaaryasoochi-server" >>"$log" 2>&1 </dev/null &
  wait_listening
}

if have_user_systemd; then
  start_with_systemd || start_detached
else
  start_detached
fi

if [ -x "$lib/app/kaaryasoochi-app" ]; then
  # Desktop assets are resolved next to the binary.
  cd "$lib/app"
  exec ./kaaryasoochi-app "$@"
fi
exec xdg-open "http://127.0.0.1:$port/"
